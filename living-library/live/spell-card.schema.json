{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spell-card.schema.json",
  "title": "Candidate SpellCard v1; semantic graph validation also required",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spell_id",
    "version",
    "name",
    "description",
    "incantations",
    "enabled",
    "target_type",
    "runes",
    "conditions",
    "effects",
    "connections"
  ],
  "properties": {
    "schema": {
      "const": "nw.spell.v1"
    },
    "spell_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "incantations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "target_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "runes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "rune-card.schema.json"
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "refs"
      ],
      "properties": {
        "operator": {
          "const": "AND"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "refs"
      ],
      "properties": {
        "operator": {
          "const": "SEQUENCE"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "operator"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "operator": {
            "enum": [
              "AND",
              "SEQUENCE"
            ]
          }
        }
      }
    }
  }
}
