{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rune-card.schema.json",
  "title": "Candidate RuneCard v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rune_id",
    "action_id",
    "action_version",
    "label",
    "parameters"
  ],
  "properties": {
    "schema": {
      "const": "nw.rune.v1"
    },
    "rune_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "action_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "label": {
      "type": "string",
      "pattern": "\\S"
    },
    "parameters": {
      "type": "object"
    }
  }
}
