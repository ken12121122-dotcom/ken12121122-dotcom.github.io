{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AMIN-GOVERNED-CHANGE-REQUEST-V1",
  "title": "Amin Governed Change Request",
  "type": "object",
  "required": ["change_id", "changed_node_ids", "change_type", "changed_paths"],
  "properties": {
    "change_id": {"type": "string", "minLength": 1},
    "changed_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AMIN-[0-9]+$"}
    },
    "change_type": {
      "enum": ["feature", "fix", "integration", "refactor", "validation", "docs", "release", "governance"]
    },
    "changed_paths": {
      "type": "array",
      "items": {"type": "string"}
    },
    "declared_dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^AMIN-[0-9]+$"}
    },
    "interface_changes": {"type": "boolean", "default": false},
    "data_schema_changes": {"type": "boolean", "default": false},
    "permission_changes": {"type": "boolean", "default": false},
    "release_path_changes": {"type": "boolean", "default": false},
    "destructive_data_change": {"type": "boolean", "default": false},
    "security_boundary_change": {"type": "boolean", "default": false}
  },
  "additionalProperties": true
}
